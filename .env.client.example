# Copy to .env.client and fill in. Never commit .env.client.
# "training" = Checkov 3.2.495 + Trivy 0.58.2 (the labelling/training versions)
CLOUDSEC_PROFILE=training
# Model server: public URL behind Cloudflare Access, or a direct address
CLOUDSEC_TRIAGE_URL=https://triage.example.com
# Cloudflare Access service token (only for the public URL)
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
